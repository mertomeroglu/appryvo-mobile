# Capacitor sync output -- regenerated by `npx cap sync android` from dist/ on every build, so
# tracking it just adds a hashed-filename diff on every commit. android/app/build.gradle,
# AndroidManifest.xml, and other real config files are NOT covered by this and stay tracked.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Test Coverage
coverage/
*.lcov

# Copied verbatim from node_modules/maplibre-gl/dist by scripts/copy-maplibre-worker-assets.mjs
# (predev/prebuild) -- generated, not source; see that script's own comment for why.
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs
