# Appryvo Mobile Environment Configuration
# Copy this file to .env or .env.local for development

VITE_API_BASE_URL=https://api.appryvo.online

# OpenMapTiles vector tile source for SocialMapScreen (MapLibre GL JS). Product decision (RYVO
# PATCH V5 02): leave unset in both dev and production -- the app then uses OpenFreeMap
# (https://tiles.openfreemap.org/planet, free, keyless, commercial use permitted, no self-hosted
# TileServer GL) automatically, see ryvoMapConfig.ts. Only set this to point at a different
# provider (self-hosted or a real paid key) -- never a demo/public key.
VITE_OPENMAPTILES_TILEJSON_URL=
# Optional overrides, only needed for a non-default provider that doesn't self-describe sprite/
# glyph URLs in its own TileJSON.
VITE_OPENMAPTILES_SPRITE_URL=
VITE_OPENMAPTILES_GLYPHS_URL=
