	<key>NSPhotoLibraryUsageDescription</key>
	<string>Profilinize ve sohbetlerinize fotoğraf yüklemek için galeri erişim izni gereklidir.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Medyaları kaydetmek için izin gereklidir.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Yakınınızdaki profilleri görüntülemek ve haritada konumunuzu göstermek için konum izni gereklidir.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sesli mesajlar ve sesli aramalar gerçekleştirmek için mikrofon erişimi gereklidir.</string>

	<!-- CONFIG REQUIRED for production: Google's own published TEST AdMob App ID
	     (ca-app-pub-3940256099942544~1458002511) -- see AndroidManifest.xml for the matching
	     Android value and mobile/src/native/admob.ts for the TEST ad unit IDs. Replace both
	     platforms' IDs together before any release build. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>

	<!-- Custom URL Scheme for Deep Links -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.appryvo.ryvo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>appryvo</string>
			</array>
		</dict>
	</array>
